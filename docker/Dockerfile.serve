# Stage 1: Base with dependencies
FROM python:3.14.6-slim AS base

WORKDIR /app

COPY requirements/base.txt .
RUN pip install --no-cache-dir -r base.txt


# Stage 2: Serving runtime
FROM base AS serving
RUN apt-get update && apt-get install --no-install-recommends -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1
ENV PATH=/root/.local/bin:$PATH

WORKDIR /app

COPY requirements/serve.txt .
RUN pip install --no-cache-dir -r serve.txt

COPY src/ ./src/
COPY configs/ ./configs/

EXPOSE 8080
RUN useradd -m serve
USER serve
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 CMD curl -f http://localhost:8080/health || exit 1

CMD ["uvicorn", "src.serve:app", "--host", "0.0.0.0", "--port", "8080"]
